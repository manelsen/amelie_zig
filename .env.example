# Amélie em Zig - Configuração

# Chave de API do Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Caminho para o banco de dados SQLite
DB_PATH=./amelie.db

# URL do WhatsApp webhook para envio (whatsmeow-bridge)
WHATSAPP_WEBHOOK_URL=http://localhost:8080/send

# Porta do servidor HTTP (onde o bridge deve mandar eventos)
PORT=3000

# Host do servidor HTTP
HOST=0.0.0.0
